generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Rarity {
  COMMON
  UNCOMMON
  RARE
  EPIC
  LEGENDARY
  MYTHIC
  RAINBOW
  SECRET
}

model Card {
  id                 String   @id @default(uuid()) @db.Uuid
  name               String   @db.VarChar(80)
  slug               String   @unique @db.VarChar(100)
  rarity             Rarity
  description        String   @db.VarChar(240)
  lore               String   @db.VarChar(500)
  attack             Int
  defense            Int
  abilityName        String   @db.VarChar(80)
  abilityDescription String   @db.VarChar(240)
  imageUrl           String   @db.VarChar(255)
  collectionNumber   Int      @unique
  active             Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([active, rarity, collectionNumber])
}

model GuestSession {
  id               String    @id @default(uuid()) @db.Uuid
  displayName      String    @db.VarChar(20)
  sessionTokenHash String    @unique @db.Char(64)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  expiresAt        DateTime
  revokedAt        DateTime?

  @@index([expiresAt])
}
